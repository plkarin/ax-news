[Unit]
Description=AX-NEWS og:image fetch for articles without a picture
After=network.target ax-news-backend.service
[Service]
Type=oneshot
User=cbrain
EnvironmentFile=/opt/ax-news/backend/.env
ExecStart=/usr/bin/curl -sf -X POST -H "X-Internal-Token: ${INTERNAL_SYNC_TOKEN}" "http://127.0.0.1:8000/api/fetch-images?limit=120"
StandardOutput=append:/var/log/ax-news/images.log
StandardError=append:/var/log/ax-news/images.log
