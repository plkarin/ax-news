[Unit]
Description=AX-NEWS purge of the stories older than PURGE_DAYS (90 days)
# Keeps PURGE_DAYS days (backend/.env, 90 by default, 70 at least) and the saved stories.
[Service]
Type=oneshot
User=cbrain
EnvironmentFile=/opt/ax-news/backend/.env
ExecStart=/usr/bin/curl -sf -X DELETE -H "X-Internal-Token: ${INTERNAL_SYNC_TOKEN}" "http://127.0.0.1:8000/api/purge"
StandardOutput=append:/var/log/ax-news/purge.log
StandardError=append:/var/log/ax-news/purge.log
