[Unit]
Description=AX-NEWS personal sources fetch
After=network.target postgresql.service

[Service]
Type=oneshot
User=cbrain
EnvironmentFile=/opt/ax-news/backend/.env
ExecStart=/opt/ax-news/backend/venv/bin/python3 /opt/ax-news/sources-worker.py
StandardOutput=append:/var/log/ax-news/sources.log
StandardError=append:/var/log/ax-news/sources.log
MemoryMax=512M
TimeoutStartSec=280
