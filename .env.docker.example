# AX-NEWS with Docker Compose. install.sh writes .env from this file, with
# fresh secrets; by hand: copy it to .env and fill in (openssl rand -hex 24).
POSTGRES_PASSWORD=
FRESHRSS_PASSWORD=
FRESHRSS_API_PASS=
# Sent by the worker to the backend to start work (sync, images, purge).
INTERNAL_SYNC_TOKEN=
# The public address: links, QR codes, the Secure flag of cookies.
APP_URL=http://localhost:8080
AXNEWS_PORT=8080
TZ=UTC

# Sign-up is closed: administrators open the accounts (docs/INSTALL.md).
# Optional: Google sign-in, mail, the social accounts of the CVE watch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MASTODON_BASE_URL=
MASTODON_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# 1: tell search engines (IndexNow) about new pages; only for a public APP_URL.
AXNEWS_INDEXNOW=0
