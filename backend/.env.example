# Argos Translate models live under this HOME (deploy/install-argos-models.sh)
HOME=/opt/ax-news/.argos-home
DATABASE_URL=postgresql://ax_news:password@127.0.0.1/ax_news
FRESHRSS_BASE_URL=http://127.0.0.1:8082
FRESHRSS_USER=
FRESHRSS_API_PASS=
CLAUDE_USER=
LOG_FILE=/var/log/ax-news/backend.log
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://ax-news.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Sent by the systemd timers (sync, images, purge) from localhost, header
# X-Internal-Token. A long random string: openssl rand -hex 32
INTERNAL_SYNC_TOKEN=
